        <!-- 这个标签指定包内的 README 文件路径，不涉及源文件路径 -->
        <readme>README.md</readme>
        <!-- 显示在NuGet搜索结果的Info那儿 -->
        <description>
            A highly customizable WPF MessageBox control, supporting custom button text, custom icons, multi-language, etc.&#10;
            一个可高度自定义的 WPF MessageBox 控件，支持按钮文字自定义、图标自定义、多语言等。
        </description>
        <tags>wpf messagebox dialog custom</tags>
        <copyright>Copyright © Actor 2026</copyright>
        <releaseNotes>更新版本发布：支持自定义按钮、图标、多语言、Builder 模式。</releaseNotes>
    </metadata>
    <files>
