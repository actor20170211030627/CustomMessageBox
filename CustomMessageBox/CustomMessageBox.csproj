<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
            Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{F699F4BE-6CCA-4CFA-A199-6DA48F6FCE99}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <!-- 更科学的命名空间 -->
        <RootNamespace>Actor.CustomMessageBox</RootNamespace>
        <AssemblyName>CustomMessageBox</AssemblyName>
        <!-- 目标框架（你的是 .NET Framework 4.6.2） -->
        <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>

        <!--
            NuGet 包元数据, 在NuGet中搜索这个名字安装.
            if 名字和其他人的项目名字重复, Github推送到NuGet的时候可能会导致403错误
         -->
        <PackageId>CustomMessageBox.Actor.WPF</PackageId>
        <Version>1.0.0</Version>
        <Authors>Actor</Authors>
        <Company>Fate</Company>
        <Description>一个高度可定制的 WPF MessageBox 控件。</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/actor20170211030627/CustomMessageBox</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>wpf;messagebox;dialog;custom</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>$(MSBuildProjectDirectory)\nupkgs</PackageOutputPath>
        <!-- 生成注释文档xml -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <!-- 需要设置注释文档xml生成位置, 否则会生成到项目根目录: CustomMessageBox\CustomMessageBox -->
        <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <!-- 需要设置注释文档xml生成位置, 否则会生成到项目根目录: CustomMessageBox\CustomMessageBox -->
        <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>
    
    <!-- Add dependencies 添加依赖 -->
    <ItemGroup>
        <Reference Include="PresentationCore" />
        <Reference Include="PresentationFramework" />
        <Reference Include="System"/>
        <Reference Include="System.Drawing" />
        <Reference Include="System.Xaml">
            <RequiredTargetFramework>4.0</RequiredTargetFramework>
        </Reference>
        <Reference Include="WindowsBase" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Builder.cs" />
        <Compile Include="IMessageBoxBuilder.cs" />
        <Compile Include="MessageBox2.xaml.cs">
          <DependentUpon>MessageBox2.xaml</DependentUpon>
        </Compile>
        <Compile Include="Properties\AssemblyInfo.cs"/>
        <Compile Include="Resources\Strings.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Strings.resx</DependentUpon>
        </Compile>
        <Compile Include="Resources\Strings.zh-CN.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Strings.zh-CN.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\Strings.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
            <!-- 强制生成的资源名称不带'Actor.'前缀, 否则Strings.cs中的ResourceManager初始化的时候没有'Actor.'前缀会找不到 -->
<!--            <LogicalName>CustomMessageBox.Resources.Strings.resources</LogicalName>-->
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Strings.zh-CN.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.zh-CN.Designer.cs</LastGenOutput>
<!--            <LogicalName>CustomMessageBox.Resources.Strings.zh-CN.resources</LogicalName>-->
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
      <Content Include=".gitignore" />
      <Content Include="README.md" />
      <Content Include="CustomMessageBox.nuspec" />
    </ItemGroup>
    <ItemGroup>
      <Page Include="MessageBox2.xaml" />
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
         Other similar extension points exist, see Microsoft.Common.targets.
    <Target Name="BeforeBuild">
    </Target>
    <Target Name="AfterBuild">
    </Target>
    -->

</Project>
